{%- doc -%}
  Pieces in stock across a collection's products: the sum of tracked variant inventory.
  Outputs -1 when no variant tracks stock, so callers can hide the counter instead of inventing a number.
  @param {object} [collection] - Drop collection
{%- enddoc -%}
{%- liquid
  assign left = 0
  assign tracked = false
  if collection != blank
    for p in collection.products limit: 50
      for v in p.variants
        if v.inventory_management == 'shopify'
          assign tracked = true
          if v.inventory_quantity > 0
            assign left = left | plus: v.inventory_quantity
          endif
        endif
      endfor
    endfor
  endif
  unless tracked
    assign left = -1
  endunless
  echo left
-%}
