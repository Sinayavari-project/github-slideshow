    "faq": {
      "type": "uscode-faq-split",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Which phones work?",
            "answer": "<p>Any iPhone from XS onward and almost every Android phone with NFC switched on. There’s no app — the memory opens in the browser. Each tag also carries a QR code as a backup.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Does the chip survive washing?",
            "answer": "<p>Yes. The chip is sealed and sits in a small diamond pocket behind the chest logo. Wash cold and inside out, and skip the tumble dryer — the same care the print needs.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Who can see my memory?",
            "answer": "<p>Only people who tap your shirt or open your private link. Memory pages aren’t listed or searchable, and you can add a passcode.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Can I change the memory later?",
            "answer": "<p>Anytime. Swap the photo, voice note, video or song from the link in your order email. The chip never needs rewriting.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How long is it hosted?",
            "answer": "<p>For as long as you own the piece, included in the price. No subscription.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Shipping times by region?",
            "answer": "<p>Ships within 48 hours of print. US & Canada 3–6 business days · UK & EU 3–7 · GCC 4–8 · Australia 5–9. Duties and taxes are shown at checkout.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "Returns on personalized items?",
            "answer": "<p>Essential and Memory can be returned unworn within 14 days — the memory links after delivery, so the tee itself isn’t personalized. Signature pieces are printed from your photo and are final sale.</p>"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "Sizing for oversized fit?",
            "answer": "<p>Cut oversized with a dropped shoulder. Take your usual size for the intended fit, or size down for a closer one. Measurements are in the size guide.</p>"
          }
        }
      },
