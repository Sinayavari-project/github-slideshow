{{ 'story.css' | asset_url | stylesheet_tag }}
<script src="{{ 'story.js' | asset_url }}" defer></script>
{%- liquid
  assign url_size = section.settings.video_url | strip | size
  assign has_video = false
  if section.settings.video or url_size > 0
    assign has_video = true
  endif
-%}
<div class="story-col">
  <section class="story-tap" data-story-tap>
    {%- if section.settings.kicker != blank -%}<span class="story-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
    <div class="story-tap__box">
      {%- if has_video -%}
        <button type="button" class="story-tap__trigger" aria-haspopup="dialog" aria-controls="StoryDialog-{{ section.id }}" data-story-trigger>
          {%- render 'eye-mark', size: 52, class: 'story-tap__pulse' -%}
          <span class="story-tap__label">{{ section.settings.label }}</span>
        </button>
      {%- else -%}
        {%- render 'eye-mark', size: 52 -%}
        <span class="story-tap__label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.hint != blank -%}<p class="story-tap__hint">{{ section.settings.hint }}</p>{%- endif -%}
      {%- if has_video == false and request.design_mode -%}<p class="story-tap__hint">Pick a video in this section's settings to turn on playback.</p>{%- endif -%}
    </div>

    {%- if has_video -%}
      <dialog class="story-dialog" id="StoryDialog-{{ section.id }}" aria-label="{{ section.settings.caption | default: section.settings.label | escape }}" data-story-dialog>
        <div data-story-slot></div>
        <template data-story-video>
          {%- if section.settings.video -%}
            {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none' }}
          {%- else -%}
            <video data-src="{{ section.settings.video_url | escape }}" controls playsinline preload="none"></video>
          {%- endif -%}
        </template>
        <div class="story-dialog__foot">
          <span class="story-dialog__caption">{{ section.settings.caption }}</span>
          <button type="button" class="story-dialog__close" data-story-close>Close</button>
        </div>
      </dialog>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Story tap to remember",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "See it work" },
    { "type": "text", "id": "label", "label": "Button label", "default": "Tap to remember" },
    { "type": "textarea", "id": "hint", "label": "Hint", "default": "This is the actual memory behind Drop 01 — click the eye like you'd tap the hem, and it plays back the same way it does on the shirt." },
    { "type": "video", "id": "video", "label": "Memory video" },
    { "type": "text", "id": "video_url", "label": "Or video file URL (.mp4)", "info": "Used only when no video is picked above." },
    { "type": "text", "id": "caption", "label": "Video footer caption", "default": "CODE-001 — the original" }
  ],
  "presets": [{ "name": "Story tap to remember" }]
}
{% endschema %}
