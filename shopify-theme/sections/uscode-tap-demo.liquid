{{ 'uscode-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uscode-home.js' | asset_url }}" defer></script>
{%- assign has_video = false -%}
{%- if section.settings.video != blank or section.settings.video_url != blank -%}{%- assign has_video = true -%}{%- endif -%}
<div class="uh">
  <section class="uh-sec{% if section.settings.flush_top %} uh-sec--flush{% endif %}">
    <div class="uh-wrap uh-demo">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="uh-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="uh-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="uh-lede">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="uh-checks" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'uscode-icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="uh-phonewrap">
        <div class="uh-phone" role="group" aria-label="Preview of a private memory page">
          <div class="uh-screen">
            <div class="uh-mp-head"><span class="wordmark" style="font-size:10px; letter-spacing:0.24em;">{{ shop.name | upcase }}</span><span>{{ section.settings.number }}</span></div>
            <div class="uh-mp-media">
              {%- if section.settings.image != blank -%}
                {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '280px' }}
              {%- endif -%}
              {%- if has_video -%}
                <button type="button" class="uh-mp-play" aria-label="Play memory" data-uh-play>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7 4v16l13-8z"/></svg>
                </button>
                <template>{% render 'uscode-video', video: section.settings.video, url: section.settings.video_url, attrs: 'controls playsinline tabindex="-1"', label: section.settings.message %}</template>
              {%- endif -%}
            </div>
            {%- if section.settings.kicker != blank -%}<p class="uh-mp-kick">{{ section.settings.kicker }}</p>{%- endif -%}
            {%- if section.settings.message != blank -%}<p class="uh-mp-msg">{{ section.settings.message }}</p>{%- endif -%}
            {%- if section.settings.audio_length != blank -%}
              <div class="uh-mp-audio" aria-hidden="true">
                <span class="uh-pb"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z"/></svg></span>
                <div class="uh-wave">
                  {%- assign wave = '30,55,40,75,60,90,45,70,35,80,65,50,85,40,60,30,70,55,45,75,35,60,40,25' | split: ',' -%}
                  {%- for w in wave -%}<i style="height:{{ w }}%;"></i>{%- endfor -%}
                </div>
                <span>{{ section.settings.audio_length }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.lock_text != blank -%}<p class="uh-mp-lock">{% render 'uscode-icon', name: 'lock' %}{{ section.settings.lock_text }}</p>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "US CODE tap demo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What they see" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tap. It plays." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The chip sits in a small diamond pocket behind the chest logo. One tap opens a private page that holds exactly what you left there.</p>" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": true },
    { "type": "header", "content": "Phone preview" },
    { "type": "text", "id": "number", "label": "Print number", "default": "042 / 300" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "video", "id": "video", "label": "Video", "info": "Pick a video from Shopify Files. Plays when the play button is pressed." },
    { "type": "text", "id": "video_url", "label": "Or video link", "info": "A full video link, or a theme asset filename." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "A memory for you" },
    { "type": "text", "id": "message", "label": "Message", "default": "“The night at the wall. I’d find you in every lifetime.”" },
    { "type": "text", "id": "audio_length", "label": "Voice note length", "default": "0:48", "info": "Leave blank to hide the voice note row." },
    { "type": "text", "id": "lock_text", "label": "Privacy line", "default": "Only people you share this with can open it." }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "limit": 5, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Private by default. Nothing is listed or searchable" }] }
  ],
  "presets": [{ "name": "US CODE tap demo", "blocks": [{ "type": "point" }] }]
}
{% endschema %}
