{{ 'story.css' | asset_url | stylesheet_tag }}
<div class="story-col">
  <section class="story-prose">{{ section.settings.text }}</section>
  {%- if section.settings.divider -%}<hr class="story-rule">{%- endif -%}
</div>

{% schema %}
{
  "name": "Story prose",
  "tag": "div",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We were standing in front of a wall that looked like it was watching us back, and one of us said the kind of thing you only say at 2am: \"I never want to forget this exact feeling.\" We took a video instead of a photo, because a photo freezes a moment and we wanted to keep the sound of it too.</p><p>A few weeks later we were still watching that clip more than we'd like to admit. That's the whole idea behind US CODE: most things you want to remember don't fit in a picture. So we built a shirt that holds the video instead: a real memory, tapped back into existence whenever you want it.</p>" },
    { "type": "checkbox", "id": "divider", "label": "Divider after text", "default": true }
  ],
  "presets": [{ "name": "Story prose" }]
}
{% endschema %}
