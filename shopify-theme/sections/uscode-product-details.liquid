{%- style -%}
  .uscode-pd {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .uscode-pd__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .uscode-pd__label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
    font-weight: 500;
  }
  .uscode-pd__heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .uscode-pd__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #666;
    max-width: 560px;
    margin-bottom: 40px;
  }
  .uscode-pd__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
    margin-bottom: 48px;
  }
  .uscode-pd__stat-num {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
  }
  .uscode-pd__stat-label {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #888;
  }
  .uscode-pd__features {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 48px;
  }
  .uscode-pd__feature {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items: start;
  }
  .uscode-pd__feat-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    padding-top: 2px;
  }
  .uscode-pd__feat-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .uscode-pd__feat-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #666;
  }
  .uscode-pd__nfc {
    background: #1A1A1A;
    color: #fff;
    padding: 32px 24px;
    margin-top: 48px;
  }
  .uscode-pd__nfc-label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
    font-weight: 500;
  }
  .uscode-pd__nfc-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #ccc;
    max-width: 480px;
  }
  @media (max-width: 749px) {
    .uscode-pd__inner { padding: 48px 20px; }
    .uscode-pd__stats { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .uscode-pd__feature { grid-template-columns: 32px 1fr; }
  }
{%- endstyle -%}

<section class="uscode-pd">
  <div class="uscode-pd__inner">
    {%- comment -%} Stats row {%- endcomment -%}
    {%- assign stats = section.blocks | where: "type", "stat" -%}
    {%- if stats.size > 0 -%}
      <div class="uscode-pd__stats">
        {%- for block in stats -%}
          <div {{ block.shopify_attributes }}>
            <div class="uscode-pd__stat-num">{{ block.settings.number }}</div>
            <div class="uscode-pd__stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Features {%- endcomment -%}
    {%- assign features = section.blocks | where: "type", "feature" -%}
    {%- if features.size > 0 -%}
      <p class="uscode-pd__label">{{ section.settings.features_label }}</p>
      <div class="uscode-pd__features">
        {%- for block in features -%}
          <div class="uscode-pd__feature" {{ block.shopify_attributes }}>
            <span class="uscode-pd__feat-num">{{ block.settings.number }}</span>
            <div>
              <h3 class="uscode-pd__feat-title">{{ block.settings.title }}</h3>
              <p class="uscode-pd__feat-text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Story section {%- endcomment -%}
    <p class="uscode-pd__label">{{ section.settings.story_label }}</p>
    <h2 class="uscode-pd__heading">{{ section.settings.story_heading }}</h2>
    <div class="uscode-pd__text">{{ section.settings.story_text }}</div>

    {%- comment -%} NFC verification block {%- endcomment -%}
    {%- if section.settings.show_nfc -%}
      <div class="uscode-pd__nfc">
        <p class="uscode-pd__nfc-label">NFC VERIFICATION</p>
        <p class="uscode-pd__nfc-text">{{ section.settings.nfc_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "US CODE Product Details",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "features_label",
      "label": "Features label",
      "default": "WHAT YOU'RE WEARING"
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Story label",
      "default": "MADE TO LAST THE MEMORY"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Screen-printed once. Verified forever."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story text",
      "default": "<p>Every shirt is numbered against its NFC chip at print — scan it and you're looking at the same file we printed, not a knockoff. When the drop sells out, that number closes.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_nfc",
      "label": "Show NFC block",
      "default": true
    },
    {
      "type": "textarea",
      "id": "nfc_text",
      "label": "NFC description",
      "default": "Tap the hem tag to verify your print number. The chip is locked to one shirt — scanning it anywhere else means it isn't real."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C83232"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "300" },
        { "type": "text", "id": "label", "label": "Label", "default": "Pieces made" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "A real pair of eyes" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "The back print is a photograph, not an illustration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "US CODE Product Details",
      "blocks": [
        { "type": "stat", "settings": { "number": "300", "label": "Pieces made. No restock." } },
        { "type": "stat", "settings": { "number": "1:1", "label": "NFC-verified to one print" } },
        { "type": "stat", "settings": { "number": "48h", "label": "Ships from print" } },
        { "type": "stat", "settings": { "number": "0", "label": "Reprints, ever" } },
        { "type": "feature", "settings": { "number": "01", "title": "A real pair of eyes", "text": "The back print is a photograph, not an illustration — torn, layered, and screen-printed at true grain." } },
        { "type": "feature", "settings": { "number": "02", "title": "Tap to remember", "text": "A hidden NFC chip in the hem links to whatever you choose to keep behind it — a voice memo, a photo, a date." } },
        { "type": "feature", "settings": { "number": "03", "title": "Heavyweight, vintage-washed", "text": "Oversized cut, garment-dyed and washed for a worn-in hand from the first day." } }
      ]
    }
  ]
}
{% endschema %}