{{ 'uscode-overrides.css' | asset_url | stylesheet_tag }}
<style>
  .uscode-proof {
    max-width: 1160px;
    margin: 0 auto;
    padding: 57px clamp(20px, 5vw, 64px);
    color: {{ section.settings.text_color }};
  }
  .uscode-proof__kicker {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 10px;
  }
  .uscode-proof__heading {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .uscode-proof__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 140px;
    gap: 2px;
    background: {{ section.settings.divider_color }};
    margin-top: 26px;
  }
  .uscode-proof__cell {
    background: {{ section.settings.bg_color }};
    position: relative;
    overflow: hidden;
  }
  .uscode-proof__cell:nth-child(1) { grid-column: span 3; grid-row: span 2; }
  .uscode-proof__cell:nth-child(2) { grid-column: span 3; grid-row: span 1; }
  .uscode-proof__cell:nth-child(3) { grid-column: span 2; grid-row: span 1; }
  .uscode-proof__cell:nth-child(4) { grid-column: span 2; grid-row: span 2; }
  .uscode-proof__cell:nth-child(5) { grid-column: span 2; grid-row: span 1; }
  .uscode-proof__cell img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .uscode-proof__cell .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .uscode-proof__quote {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
  }
  .uscode-proof__quote p {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .uscode-proof__quote span {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    margin-top: 10px;
    opacity: 0.65;
  }
  @media (max-width: 720px) {
    .uscode-proof__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
    .uscode-proof__cell { grid-column: span 1 !important; grid-row: span 1 !important; }
  }
</style>

<section class="uscode-proof">
  <span class="uscode-proof__kicker">{{ section.settings.kicker }}</span>
  <h2 class="uscode-proof__heading">{{ section.settings.heading }}</h2>
  <div class="uscode-proof__grid">
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        <div class="uscode-proof__cell" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {% elsif block.type == 'quote' %}
        <div class="uscode-proof__cell uscode-proof__quote" {{ block.shopify_attributes }}>
          <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <span>{{ block.settings.attribution }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "US CODE Proof Grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Worn by the first 300" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the drop." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F2F2F2" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1F1E1C" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#582123" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#D8D6D1" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "quote",
      "name": "Quote tile",
      "settings": [
        { "type": "text", "id": "quote", "label": "Quote", "default": "Felt like unwrapping something that mattered." },
        { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Essential, 042/300" }
      ]
    }
  ],
  "presets": [
    {
      "name": "US CODE Proof Grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "quote", "settings": { "quote": "Felt like unwrapping something that mattered.", "attribution": "— Essential, 042/300" } },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
