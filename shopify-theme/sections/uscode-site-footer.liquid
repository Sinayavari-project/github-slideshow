{{ 'uscode-overrides.css' | asset_url | stylesheet_tag }}
<style>
  .uscode-footer {
    max-width: 1160px;
    margin: 0 auto;
    padding: 52px clamp(20px, 5vw, 64px) 32px;
    color: {{ section.settings.text_color }};
  }
  .uscode-footer__cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 26px;
  }
  .uscode-footer__wordmark {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
  }
  .uscode-footer__wordmark svg { margin-right: 0.6em; flex: none; }
  .uscode-footer__tagline {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    max-width: 32ch;
    margin: 14px 0 0;
    opacity: 0.7;
  }
  .uscode-footer__cols h4 {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px;
    opacity: 0.65;
  }
  .uscode-footer__cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .uscode-footer__cols a {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }
  .uscode-footer__cols a:hover { color: {{ section.settings.accent_color }}; }
  .uscode-footer__support { margin: 14px 0 0; font-family: var(--font-body); font-size: 13px; line-height: 20px; max-width: 34ch; }
  .uscode-footer__support a { color: {{ section.settings.text_color }}; text-decoration: underline; text-underline-offset: 3px; }
  .uscode-footer__support span { display: block; opacity: 0.7; }
  .uscode-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid {{ section.settings.divider_color }};
    font-family: var(--font-body);
    font-size: 12px;
  }
  .uscode-footer__bottom ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .uscode-footer__bottom a { color: {{ section.settings.text_color }}; text-decoration: none; }
  .uscode-footer__bottom a:hover { color: {{ section.settings.accent_color }}; }
  @media (max-width: 720px) {
    .uscode-footer__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 989px) {
    .uscode-footer__cols a, .uscode-footer__bottom a { display: inline-flex; align-items: center; min-height: 44px; }
    .uscode-footer__cols ul { gap: 0; }
    /* keep the last line clear of the chat bubble in the bottom-right corner */
    .uscode-footer { padding-bottom: calc(32px + var(--uscode-chat-clearance, 84px)); }
  }
</style>

<footer class="uscode-footer">
  <div class="uscode-footer__cols">
    <div>
      <span class="uscode-footer__wordmark">
        <svg width="18" height="13" viewBox="0 -1 28 22" fill="none"><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 13c3.5-5 7.5-7.5 12-7.5s8.5 2.5 12 7.5c-3.5 5-7.5 7.5-12 7.5S5.5 18 2 13z"/><circle cx="14" cy="13" r="3" fill="currentColor" stroke="none"/><path d="M14 5.5V1M9 6.3L7.3 2.2M19 6.3l1.7-4.1M4.8 8.6L2.2 5.4M23.2 8.6l2.6-3.2"/></g></svg>
        US CODE
      </span>
      <p class="uscode-footer__tagline">{{ section.settings.tagline }}</p>
      {%- if section.settings.support_email != blank or section.settings.chat_note != blank -%}
        <p class="uscode-footer__support">
          {%- if section.settings.support_email != blank -%}
            <a href="mailto:{{ section.settings.support_email | strip }}">{{ section.settings.support_email | strip }}</a>
          {%- endif -%}
          {%- if section.settings.chat_note != blank -%}<span>{{ section.settings.chat_note }}</span>{%- endif -%}
        </p>
      {%- endif -%}
    </div>
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.title }}</h4>
        <ul>
          {%- if block.type == 'tiers' -%}
            {%- liquid
              assign tp = block.settings.product
              assign tier_option = block.settings.option_name | default: 'Tier' | downcase
              assign t_index = -1
              for option in tp.options_with_values
                assign oname = option.name | downcase
                if oname == tier_option
                  assign t_index = forloop.index0
                endif
              endfor
            -%}
            {%- if tp != blank and t_index >= 0 -%}
              {%- for value in tp.options_with_values[t_index].values -%}
                {%- liquid
                  assign tier_variant = nil
                  for v in tp.variants
                    if v.options[t_index] == value and v.available
                      assign tier_variant = v
                      break
                    endif
                  endfor
                  if tier_variant == nil
                    for v in tp.variants
                      if v.options[t_index] == value
                        assign tier_variant = v
                        break
                      endif
                    endfor
                  endif
                -%}
                <li><a href="{{ tp.url }}?variant={{ tier_variant.id }}">{{ value }}</a></li>
              {%- endfor -%}
            {%- elsif tp != blank -%}
              <li><a href="{{ tp.url }}">{{ tp.title }}</a></li>
            {%- endif -%}
          {%- else -%}
            {% assign links = block.settings.links | split: '|' %}
            {% assign urls = block.settings.urls | split: '|' %}
            {% for link in links %}
              <li><a href="{% if urls[forloop.index0] != blank %}{{ urls[forloop.index0] }}{% else %}#{% endif %}">{{ link }}</a></li>
            {% endfor %}
          {%- endif -%}
        </ul>
      </div>
    {% endfor %}
  </div>

  <div class="uscode-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand | default: 'US CODE' }}</span>
    <ul role="list" aria-label="Policies">
      {%- comment -%} shop.policies lists every policy that has content: privacy, refund, shipping, terms {%- endcomment -%}
      {%- for policy in shop.policies -%}
        <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "US CODE Footer",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Printed once. Verified forever. uscode.co" },
    { "type": "text", "id": "brand", "label": "Name in copyright line", "default": "US CODE" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "support@theuscode.com" },
    { "type": "text", "id": "chat_note", "label": "Live chat line", "default": "Live chat: tap the bubble bottom-right, we reply within a few hours (GST)." },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1F1E1C" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#582123" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#D8D6D1" }
  ],
  "blocks": [
    {
      "type": "tiers",
      "name": "Tier links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Shop" },
        { "type": "product", "id": "product", "label": "Product", "info": "One link per tier, each opening that tier's variant (?variant=)." },
        { "type": "text", "id": "option_name", "label": "Tier option name", "default": "Tier" }
      ]
    },
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Shop" },
        { "type": "text", "id": "links", "label": "Links (pipe-separated)", "default": "Essential|Memory|Signature" },
        { "type": "text", "id": "urls", "label": "URLs (pipe-separated)", "default": "||" }
      ]
    }
  ],
  "presets": [
    {
      "name": "US CODE Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Shop", "links": "Essential|Memory|Signature" } },
        { "type": "column", "settings": { "title": "About", "links": "The story|How NFC works|Verify a piece" } },
        { "type": "column", "settings": { "title": "Help", "links": "Shipping|Care guide|FAQ|Contact" } }
      ]
    }
  ]
}
{% endschema %}
