{%- style -%}
  .uscode-nfc {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 64px 24px;
  }
  .uscode-nfc__inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .uscode-nfc__eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
    font-weight: 500;
  }
  .uscode-nfc__heading {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 20px;
    font-style: italic;
  }
  .uscode-nfc__text {
    font-size: 1rem;
    line-height: 1.7;
    color: #666;
    max-width: 520px;
  }
  .uscode-nfc__text p { margin: 0 0 12px; }
  .uscode-nfc__text p:last-child { margin-bottom: 0; }
  .uscode-nfc__chip {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid {{ section.settings.border_color }};
  }
  .uscode-nfc__chip-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: {{ section.settings.accent_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .uscode-nfc__chip-icon svg {
    width: 24px;
    height: 24px;
    fill: #fff;
  }
  .uscode-nfc__chip-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .uscode-nfc__chip-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #888;
  }
{%- endstyle -%}

<section class="uscode-nfc">
  <div class="uscode-nfc__inner">
    <p class="uscode-nfc__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="uscode-nfc__heading">{{ section.settings.heading }}</h2>
    <div class="uscode-nfc__text">{{ section.settings.body }}</div>

    {%- if section.settings.show_chip -%}
    <div class="uscode-nfc__chip">
      <div class="uscode-nfc__chip-icon">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
      </div>
      <div>
        <p class="uscode-nfc__chip-label">{{ section.settings.chip_label }}</p>
        <p class="uscode-nfc__chip-desc">{{ section.settings.chip_desc }}</p>
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "US CODE NFC Verify",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MADE TO LAST THE MEMORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Screen-printed once. Verified forever." },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Every print is numbered and linked to a tamper-proof NFC chip sewn into the hem. Tap your phone to see the edition number, the print date, and the story behind the image.</p><p>No app needed. No account. Just tap.</p>" },
    { "type": "checkbox", "id": "show_chip", "label": "Show NFC chip block", "default": true },
    { "type": "text", "id": "chip_label", "label": "Chip label", "default": "NFC VERIFIED" },
    { "type": "text", "id": "chip_desc", "label": "Chip description", "default": "Each shirt carries a unique chip — tap to verify your edition." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F5F0" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C83232" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#DDDDDD" }
  ]
}
{% endschema %}
