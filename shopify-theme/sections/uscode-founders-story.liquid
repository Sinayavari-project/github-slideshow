{{ 'uscode-overrides.css' | asset_url | stylesheet_tag }}
<style>
  .uscode-fstory {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 clamp(20px, 6vw, 48px);
    color: {{ section.settings.text_color }};
    font-family: var(--font-body);
  }
  .uscode-fstory__kicker {
    display: block;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 13px;
  }
  .uscode-fstory__hero { padding: 68px 0 42px; }
  .uscode-fstory__display {
    font-weight: 700;
    font-size: clamp(36px, 8vw, 56px);
    line-height: clamp(38px, 8.5vw, 59px);
    letter-spacing: -0.02em;
    margin: 0 0 0 -0.05em;
  }
  .uscode-fstory__display span { display: block; }
  .uscode-fstory__sub {
    font-size: 16.5px;
    line-height: 26px;
    max-width: 48ch;
    margin: 22px 0 0;
    opacity: 0.82;
  }
  .uscode-fstory__fig { margin: 0 calc(-1 * clamp(20px, 6vw, 48px)); }
  .uscode-fstory__fig img,
  .uscode-fstory__fig .placeholder-svg {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }
  .uscode-fstory__fig--mono img { filter: grayscale(1) contrast(1.05); }
  .uscode-fstory__fig figcaption {
    font-size: 12px;
    letter-spacing: 0.04em;
    margin: 10px clamp(20px, 6vw, 48px) 0;
    opacity: 0.65;
  }
  .uscode-fstory__prose { padding: 47px 0; }
  .uscode-fstory__prose p {
    font-size: 16px;
    line-height: 27px;
    margin: 0 0 13px;
    max-width: 58ch;
    opacity: 0.85;
  }
  .uscode-fstory__prose p:last-child { margin-bottom: 0; }
  .uscode-fstory__rule { height: 2px; border: 0; margin: 0; background: {{ section.settings.divider_color }}; }
  .uscode-fstory__demo { padding: 47px 0 57px; }
  .uscode-fstory__box {
    border: 2px solid {{ section.settings.text_color }};
    padding: 42px clamp(20px, 5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 13px;
  }
  .uscode-fstory__tap {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
  }
  .uscode-fstory__tap:hover { color: {{ section.settings.accent_color }}; }
  .uscode-fstory__tap:focus-visible { outline: 2px solid {{ section.settings.accent_color }}; outline-offset: 4px; }
  .uscode-fstory__tap-label { font-weight: 700; font-size: 18px; letter-spacing: 0.01em; }
  .uscode-fstory__hint {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    max-width: 40ch;
    opacity: 0.7;
    margin: 0;
  }
  .uscode-fstory__pulse { animation: uscode-pulse 2.2s ease-in-out infinite; }
  @keyframes uscode-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  @media (prefers-reduced-motion: reduce) { .uscode-fstory__pulse { animation: none; } }
  .uscode-fstory__dialog {
    padding: 0;
    border: 2px solid {{ section.settings.bg_color }};
    background: {{ section.settings.text_color }};
    max-width: 420px;
    width: calc(100% - 48px);
  }
  .uscode-fstory__dialog::backdrop { background: rgba(31, 30, 28, 0.85); }
  .uscode-fstory__dialog video { width: 100%; display: block; max-height: 70vh; }
  .uscode-fstory__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
  }
  .uscode-fstory__foot span {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.bg_color }};
    opacity: 0.7;
  }
  .uscode-fstory__foot button {
    background: none;
    border: none;
    color: {{ section.settings.bg_color }};
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
</style>

{%- liquid
  assign has_video = false
  assign src_size = section.settings.video_src | strip | size
  if section.settings.video or src_size > 0
    assign has_video = true
  endif
-%}

<div class="uscode-fstory" id="story">
  <section class="uscode-fstory__hero">
    <span class="uscode-fstory__kicker">{{ section.settings.kicker }}</span>
    <h1 class="uscode-fstory__display">
      <span>{{ section.settings.heading_line1 }}</span>
      <span>{{ section.settings.heading_line2 }}</span>
    </h1>
    <p class="uscode-fstory__sub">{{ section.settings.intro }}</p>
  </section>

  <figure class="uscode-fstory__fig {% if section.settings.grayscale %}uscode-fstory__fig--mono{% endif %}">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.caption }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {% if section.settings.caption != blank %}
      <figcaption>{{ section.settings.caption }}</figcaption>
    {% endif %}
  </figure>

  <section class="uscode-fstory__prose">{{ section.settings.body }}</section>

  {% if has_video %}
    <hr class="uscode-fstory__rule">
    <section class="uscode-fstory__demo">
      <span class="uscode-fstory__kicker">{{ section.settings.demo_kicker }}</span>
      <div class="uscode-fstory__box">
        <button type="button" class="uscode-fstory__tap" aria-haspopup="dialog" data-fstory-open>
          <svg class="uscode-fstory__pulse" width="52" height="37" viewBox="0 -1 28 22" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 13c3.5-5 7.5-7.5 12-7.5s8.5 2.5 12 7.5c-3.5 5-7.5 7.5-12 7.5S5.5 18 2 13z"/><circle cx="14" cy="13" r="3" fill="currentColor" stroke="none"/><path d="M14 5.5V1M9 6.3L7.3 2.2M19 6.3l1.7-4.1M4.8 8.6L2.2 5.4M23.2 8.6l2.6-3.2"/></g></svg>
          <span class="uscode-fstory__tap-label">{{ section.settings.demo_label }}</span>
        </button>
        <p class="uscode-fstory__hint">{{ section.settings.demo_hint }}</p>
      </div>
    </section>

    <dialog class="uscode-fstory__dialog" aria-label="{{ section.settings.video_label | escape }}" data-fstory-dialog>
      {% if section.settings.video %}
        {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none' }}
      {% else %}
        <video src="{{ section.settings.video_src }}" controls playsinline preload="none"></video>
      {% endif %}
      <div class="uscode-fstory__foot">
        <span>{{ section.settings.video_label }}</span>
        <button type="button" data-fstory-close>Close</button>
      </div>
    </dialog>

    <script>
      (function () {
        var root = document.getElementById('shopify-section-{{ section.id }}');
        var dialog = root.querySelector('[data-fstory-dialog]');
        var video = dialog.querySelector('video');
        function close() { dialog.close(); }
        root.querySelector('[data-fstory-open]').addEventListener('click', function () {
          dialog.showModal();
          video.currentTime = 0;
          video.play().catch(function () {});
        });
        root.querySelector('[data-fstory-close]').addEventListener('click', close);
        dialog.addEventListener('click', function (e) { if (e.target === dialog) close(); });
        dialog.addEventListener('close', function () { video.pause(); });
      })();
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "US CODE Founders Story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The story" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "Two people." },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "One memory." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "US CODE started as a way to keep one night from fading — Sina and Vida, a mural neither of us can un-see, and a memory we didn't want to just remember. We wanted to be able to play it back." },
    { "type": "image_picker", "id": "image", "label": "Founders photo" },
    { "type": "checkbox", "id": "grayscale", "label": "Black & white photo", "default": true },
    { "type": "text", "id": "caption", "label": "Photo caption", "default": "Sina & Vida — the night it started." },
    { "type": "richtext", "id": "body", "label": "Story", "default": "<p>We were standing in front of a wall that looked like it was watching us back, and one of us said the kind of thing you only say at 2am: \"I never want to forget this exact feeling.\" We took a video instead of a photo, because a photo freezes a moment and we wanted to keep the sound of it too.</p><p>A few weeks later we were still watching that clip more than we'd like to admit. That's the whole idea behind US CODE: most things you want to remember don't fit in a picture. So we built a shirt that holds the video instead — a real memory, tapped back into existence whenever you want it.</p>" },
    { "type": "header", "content": "Tap to remember" },
    { "type": "video", "id": "video", "label": "Memory video", "info": "Upload the founders' clip. The Tap to remember block only shows once a video is set." },
    { "type": "text", "id": "video_src", "label": "Or video file URL (.mp4)" },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "CODE-001 — the original" },
    { "type": "text", "id": "demo_kicker", "label": "Demo kicker", "default": "See it work" },
    { "type": "text", "id": "demo_label", "label": "Button label", "default": "Tap to remember" },
    { "type": "textarea", "id": "demo_hint", "label": "Hint", "default": "This is the actual memory behind Drop 01 — click the eye like you'd tap the hem, and it plays back the same way it does on the shirt." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F2F2F2" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1F1E1C" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#582123" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#D8D6D1" }
  ],
  "presets": [{ "name": "US CODE Founders Story" }]
}
{% endschema %}
