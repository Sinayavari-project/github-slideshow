{{ 'uscode-home.css' | asset_url | stylesheet_tag }}
<div class="uh">
  <section class="uh-signup" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="uh-wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="uh-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="uh-signup__s">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div>
        {%- assign form_id = 'Signup-' | append: section.id -%}
        {%- form 'customer', id: form_id, class: 'uh-sform' -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.tag | escape }}">
          {%- if form.posted_successfully? -%}
            <p class="uh-done" role="status">{{ section.settings.success }}</p>
          {%- else -%}
            <div class="uh-sform__fld">
              <input type="email" name="contact[email]" id="SignupEmail-{{ section.id }}" required autocomplete="email" placeholder="{{ section.settings.placeholder }}" aria-label="Email address"{% if form.errors %} aria-invalid="true" aria-describedby="SignupError-{{ section.id }}"{% endif %}>
              <button type="submit">{{ section.settings.button }}</button>
            </div>
            {%- if form.errors -%}<p class="uh-err" id="SignupError-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- if section.settings.consent != blank -%}<div class="uh-consent">{{ section.settings.consent }}</div>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "US CODE signup",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 02" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get first access to Drop 02." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One email when it opens, 24 hours before everyone else. Nothing in between." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "button", "label": "Button", "default": "Get first access" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You’re on the list. We’ll write once, when Drop 02 opens." },
    { "type": "richtext", "id": "consent", "label": "Consent note", "default": "<p>By signing up you agree to receive emails from US CODE. Unsubscribe anytime. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</p>" },
    { "type": "text", "id": "tag", "label": "Customer tag", "default": "newsletter, drop-02" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#582123" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F2F2" }
  ],
  "presets": [{ "name": "US CODE signup" }]
}
{% endschema %}
