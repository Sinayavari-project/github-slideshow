{%- style -%}
  .uscode-features {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .uscode-features__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .uscode-features__label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 40px;
    font-weight: 500;
  }
  .uscode-features__list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .uscode-feature {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    align-items: start;
  }
  .uscode-feature__number {
    font-size: 0.75rem;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    padding-top: 2px;
  }
  .uscode-feature__title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .uscode-feature__text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #666;
    max-width: 480px;
  }
  @media (max-width: 749px) {
    .uscode-features__inner { padding: 48px 20px; }
    .uscode-feature { grid-template-columns: 36px 1fr; }
  }
{%- endstyle -%}

<section class="uscode-features">
  <div class="uscode-features__inner">
    <p class="uscode-features__label">{{ section.settings.label }}</p>
    <div class="uscode-features__list">
      {%- for block in section.blocks -%}
        <div class="uscode-feature" {{ block.shopify_attributes }}>
          <span class="uscode-feature__number">{{ block.settings.number }}</span>
          <div>
            <h3 class="uscode-feature__title">{{ block.settings.title }}</h3>
            <p class="uscode-feature__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "US CODE Features",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "WHAT YOU'RE WEARING"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C83232"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A real pair of eyes"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "The back print is a photograph, not an illustration — torn, layered, and screen-printed at true grain so the eyes stay recognizably someone's."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "US CODE Features",
      "blocks": [
        { "type": "feature", "settings": { "number": "01", "title": "A real pair of eyes", "text": "The back print is a photograph, not an illustration — torn, layered, and screen-printed at true grain so the eyes stay recognizably someone's." } },
        { "type": "feature", "settings": { "number": "02", "title": "Tap to remember", "text": "A hidden NFC chip in the hem links to whatever you choose to keep behind it — a voice memo, a photo, a date. Tap a phone to the hem and it plays." } },
        { "type": "feature", "settings": { "number": "03", "title": "Heavyweight, vintage-washed", "text": "Oversized cut, garment-dyed and washed for a worn-in hand from the first day. Runs true to a size up." } }
      ]
    }
  ]
}
{% endschema %}