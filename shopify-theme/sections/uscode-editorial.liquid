{{ 'uscode-overrides.css' | asset_url | stylesheet_tag }}
<style>
  .uscode-editorial {
    max-width: 1160px;
    margin: 0 auto;
    padding: 52px clamp(20px, 5vw, 64px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 80px);
    align-items: center;
    color: {{ section.settings.text_color }};
  }
  .uscode-editorial--reverse .uscode-editorial__fig { order: -1; }
  .uscode-editorial__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: {{ section.settings.accent_color }};
    font-feature-settings: "tnum" 1;
    margin: 0 0 10px;
    display: block;
  }
  .uscode-editorial__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .uscode-editorial__text {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 23px;
    margin: 13px 0 0;
    max-width: 46ch;
    opacity: 0.78;
  }
  .uscode-editorial__fig img {
    width: 100%;
    aspect-ratio: 5/4;
    object-fit: cover;
    display: block;
  }
  .uscode-editorial__fig .placeholder-svg { width: 100%; aspect-ratio: 5/4; }
  @media (max-width: 800px) {
    .uscode-editorial { grid-template-columns: 1fr; }
    .uscode-editorial--reverse .uscode-editorial__fig { order: 0; }
  }
</style>

<section class="uscode-editorial {% if section.settings.reverse %}uscode-editorial--reverse{% endif %}">
  <div class="uscode-editorial__copy">
    {% if section.settings.number != blank %}
      <span class="uscode-editorial__num">{{ section.settings.number }}</span>
    {% endif %}
    <h2 class="uscode-editorial__title">{{ section.settings.heading }}</h2>
    <p class="uscode-editorial__text">{{ section.settings.text }}</p>
  </div>
  <figure class="uscode-editorial__fig">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </figure>
</section>

{% schema %}
{
  "name": "US CODE Editorial",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A memory, not a graphic." },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Every back print starts as a real photograph — someone's actual eyes, torn and layered by hand before it's screen-printed at true grain. Nothing on the shirt is generated." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on left", "default": false },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1F1E1C" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#582123" }
  ],
  "presets": [{ "name": "US CODE Editorial" }]
}
{% endschema %}
