{%- style -%}
  .uscode-story {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .uscode-story__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .uscode-story__label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
    font-weight: 500;
  }
  .uscode-story__heading {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    max-width: 600px;
  }
  .uscode-story__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #666;
    max-width: 560px;
  }
  .uscode-story__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 4px;
    margin-bottom: 48px;
  }
  .uscode-story__gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 749px) {
    .uscode-story__inner { padding: 48px 20px; }
    .uscode-story__gallery { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<section class="uscode-story">
  {%- if section.blocks.size > 0 -%}
    <div class="uscode-story__gallery">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="uscode-story__inner">
    <p class="uscode-story__label">{{ section.settings.label }}</p>
    <h2 class="uscode-story__heading">{{ section.settings.heading }}</h2>
    <div class="uscode-story__text">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "US CODE Story",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "MADE TO LAST THE MEMORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Screen-printed once. Verified forever."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every shirt is numbered against its NFC chip at print — scan it and you're looking at the same file we printed, not a knockoff. When the drop sells out, that number closes.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C83232"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "US CODE Story",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}