{{ 'uscode-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign total = section.settings.edition_total | default: 300
-%}
<div class="uh">
  <section class="uh-sec uh-rule">
    <div class="uh-wrap uh-first">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="uh-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="uh-h2">{{ section.settings.heading | replace: '[total]', total }}</h2>
        {%- if section.settings.text != blank -%}<div class="uh-lede">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="uh-ctas"><a class="btn btn-primary" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a></div>
        {%- endif -%}
      </div>
      <div>
        <div class="uh-cells" role="img" aria-label="{{ total }} numbered pieces in the drop">
          {%- for i in (1..total) -%}<i></i>{%- endfor -%}
        </div>
        <div class="uh-legend">
          <span><i></i>{{ total }} numbers, each printed once</span>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "US CODE numbers grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 is live" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be one of the first [total]. Your number is waiting." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>When the first pieces land, this space fills with photos from the people wearing them. Until then, every square is a number still open.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Claim your number" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "range", "id": "edition_total", "label": "Pieces in the drop", "min": 20, "max": 500, "step": 10, "default": 300, "info": "Edition size shown in the heading and grid. Not a stock count." }
  ],
  "presets": [{ "name": "US CODE numbers grid" }]
}
{% endschema %}
