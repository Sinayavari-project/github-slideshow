{{ 'uscode-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uscode-home.js' | asset_url }}" defer></script>
{%- assign first = section.blocks.first -%}
<div class="uh">
  <section class="uh-sec uh-rule">
    <div class="uh-wrap uh-split uh-split--gift">
      <figure class="uh-shot">
        <div class="uh-frame">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 861px) 52vw, 100vw' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if section.settings.caption != blank -%}<figcaption>{{ section.settings.caption }}</figcaption>{%- endif -%}
      </figure>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="uh-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="uh-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="uh-lede">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="uh-chips" role="group" aria-label="Occasion">
            {%- for block in section.blocks -%}
              <button type="button" class="uh-chip" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-uh-occ data-label="{{ block.settings.label | downcase | escape }}" data-idea="{{ block.settings.idea | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
            {%- endfor -%}
          </div>
          <p class="uh-idea" aria-live="polite"><span class="uh-idea__lbl">Idea for <span data-uh-idea-label>{{ first.settings.label | downcase }}</span></span><span data-uh-idea-text>{{ first.settings.idea }}</span></p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="uh-ctas" style="margin-top:24px;"><a class="btn btn-primary" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a></div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}<p class="uh-giftnote">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "US CODE gifting",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifting" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for two." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One of you wears it. The other left something inside it. For anniversaries, distance, and everything in between.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop as a gift" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Free gift wrap and a handwritten card. Choose a delivery date at checkout — the memory can be added after they open it." }
  ],
  "blocks": [
    { "type": "occasion", "name": "Occasion", "limit": 6, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Anniversary" },
      { "type": "textarea", "id": "idea", "label": "Idea", "default": "Record the song from your first dance and let it play every time they wear it." }
    ] }
  ],
  "presets": [{ "name": "US CODE gifting", "blocks": [{ "type": "occasion" }] }]
}
{% endschema %}
